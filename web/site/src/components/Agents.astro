---
import CodeBlock from "./CodeBlock.astro";

const agents = [
  {
    label: "claude code",
    title: "Claude Code",
    description:
      "Writes the Claude Code MCP entry and a CLAUDE.md block between sentinels. Running it again updates that block and leaves the rest of the file alone.",
    status: "setup command",
    docsHref: "https://vivekpal1.github.io/kdo/docs/mcp#claude-code",
    snippets: [
      {
        caption: "one-command setup",
        code: "kdo setup claude --global",
        lang: "bash",
      },
      {
        caption: "preview first (writes nothing)",
        code: "kdo setup claude --global --dry-run",
        lang: "bash",
      },
    ],
  },
  {
    label: "openclaw",
    title: "OpenClaw",
    description:
      "Writes an AgentSkills SKILL.md and merges the MCP server into ~/.openclaw/openclaw.json. The openclaw profile uses a 3-call loop window.",
    status: "setup command",
    docsHref: "https://vivekpal1.github.io/kdo/docs/mcp#openclaw",
    snippets: [
      {
        caption: "one-command setup",
        code: "kdo setup openclaw --global",
        lang: "bash",
      },
      {
        caption: "preview first (writes nothing)",
        code: "kdo setup openclaw --global --dry-run",
        lang: "bash",
      },
    ],
  },
];

const statusLabel = (status: string) => status;
---

<section id="agents" class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-2xl text-center">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-tide">mcp</p>
    <h2 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      Register the server once.
    </h2>
    <p class="mt-5 text-lg text-ink-3">
      <code class="rounded bg-canvas-2 px-1.5 py-0.5 font-mono text-sm text-ink">kdo setup</code> writes the client config.
      <code class="rounded bg-canvas-2 px-1.5 py-0.5 font-mono text-sm text-ink">--dry-run</code> prints the files and writes nothing.
      Cursor, Zed, Cline, and Continue use
      <code class="rounded bg-canvas-2 px-1.5 py-0.5 font-mono text-sm text-ink">kdo serve --transport stdio --agent generic</code>.
    </p>
  </div>

  <div class="mx-auto mt-12 grid max-w-4xl gap-4 lg:grid-cols-2">
    {
      agents.map((agent) => (
        <div class="glass flex flex-col rounded-2xl p-5 sm:p-6">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-mono text-xs uppercase tracking-[0.18em] text-tide">{agent.label}</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-3">
              {statusLabel(agent.status)}
            </span>
          </div>

          <h3 class="mt-2 text-xl font-medium tracking-tight text-ink">{agent.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-3">{agent.description}</p>

          <div class="mt-5 flex flex-1 flex-col gap-3">
            {agent.snippets.map((s) => (
              <div>
                <span class="mb-1.5 block font-mono text-[10px] uppercase tracking-[0.18em] text-ink-3">
                  {s.caption}
                </span>
                <CodeBlock code={s.code} lang={s.lang} block />
              </div>
            ))}
          </div>

          <a
            href={agent.docsHref}
            class="mt-4 inline-flex items-center gap-1 text-[11px] text-ink-3 transition-colors duration-100 ease-out hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
          >
            MCP reference ↗
          </a>
        </div>
      ))
    }
  </div>

  <div class="mx-auto mt-10 max-w-2xl rounded-2xl border border-line bg-canvas-2/60 px-5 py-4 text-sm text-ink-2">
    <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-tide">keys</span>
    <p class="mt-2 leading-relaxed text-ink-3">
      Factory runs use your key. Set <code class="rounded bg-canvas px-1.5 py-0.5 font-mono text-sm text-ink">ANTHROPIC_API_KEY</code> or
      <code class="rounded bg-canvas px-1.5 py-0.5 font-mono text-sm text-ink">OPENAI_API_KEY</code>, or put names under
      <code class="rounded bg-canvas px-1.5 py-0.5 font-mono text-sm text-ink">[keys]</code> in
      <code class="rounded bg-canvas px-1.5 py-0.5 font-mono text-sm text-ink">~/.kdo/credentials.toml</code>.
      <code class="rounded bg-canvas px-1.5 py-0.5 font-mono text-sm text-ink">kdo keys status</code> prints set or missing, never the secret.
      With no key, the factory uses a mock provider.
    </p>
  </div>
</section>
