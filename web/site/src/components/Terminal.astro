---
// Terminal-card showing real `kdo` output. Static. Typography does the work.
// Uses Geist Mono with tabular numerics. Very subtle window chrome.
---

<div class="glass relative w-full max-w-3xl rounded-2xl p-1 shadow-[0_30px_80px_-20px_rgba(20,30,50,0.18)]">
  <div class="rounded-[14px] bg-canvas-2/70 px-5 py-4 sm:px-6 sm:py-5">
    <!-- chrome -->
    <div class="flex items-center justify-between border-b border-fog/60 pb-3">
      <div class="flex items-center gap-1.5">
        <span aria-hidden="true" class="block h-2.5 w-2.5 rounded-full bg-fog"></span>
        <span aria-hidden="true" class="block h-2.5 w-2.5 rounded-full bg-fog"></span>
        <span aria-hidden="true" class="block h-2.5 w-2.5 rounded-full bg-fog"></span>
      </div>
      <span class="font-mono text-[11px] tracking-tight text-ink-3">~/my-monorepo</span>
    </div>

    <!-- output -->
    <pre class="mt-3 overflow-x-auto font-mono text-[13px] leading-6 text-ink-2 tabular-nums sm:text-sm"><code><span class="text-ink-3">$</span> <span class="text-ink">kdo init</span>
<span class="text-ink-3">  4 projects</span> <span class="text-ink">rust, typescript, python, anchor</span>
<span class="text-ink-3">  wrote kdo.toml and .kdo/context/</span>

<span class="text-ink-3">$</span> <span class="text-ink">kdo context vault-program --budget 2048</span>
<span class="text-ink-3">  vault-program.md</span> <span class="text-ink">under budget</span>

<span class="text-ink-3">$</span> <span class="text-ink">kdo apply -f specs/hello.yaml</span>
<span class="text-ink-3">  created spec</span> <span class="text-ink">hello</span>
<span class="text-ink-3">$</span> <span class="text-ink">kdo factory tick</span>
<span class="text-ink-3">  plan, implement, test, review</span>
<span class="text-ink-3">  merge waits if the checkout is dirty</span></code></pre>
  </div>
</div>
